        newScores[5] = { score1: 20, score2: 24 };
        newScores[7] = { score1: 20, score2: 27 };
      }

      for (let i = 0; i < 8; i++) {
        if (!current_locked[i]) {
          current_outcomes[i] = newOutcomes[i];
          current_scores[i] = newScores[i];
        }
      }
      saveStateToStorage();
      renderMatchCards();
      calculateAndRenderStandings();
      renderPatternsList(currentFilter);
    }

    function calculateAndRenderStandings() {
      const matches = {};
      RAW_DATA.past_matches.forEach(m => {
        matches[m.team1 + '_' + m.team2] = { score1: m.score1, score2: m.score2, winner: m.winner, round: m.round };
        matches[m.team2 + '_' + m.team1] = { score1: m.score2, score2: m.score1, winner: m.winner, round: m.round };
      });

      const futurePairs = new Set();
      RAW_DATA.rem_games.forEach((g, idx) => {
        const winner = current_outcomes[idx] === null ? null : (current_outcomes[idx] === 0 ? g.team1 : g.team2);
        const s1 = current_scores[idx].score1;
        const s2 = current_scores[idx].score2;
        matches[g.team1 + '_' + g.team2] = { score1: s1, score2: s2, winner: winner, round: g.round };
        matches[g.team2 + '_' + g.team1] = { score1: s2, score2: s1, winner: winner, round: g.round };
        futurePairs.add([g.team1, g.team2].sort().join('_'));
      });

      const wins = {};
      const losses = {};
      RAW_DATA.teams.forEach(t => {
        wins[t] = 0;
        losses[t] = 0;
      });

      RAW_DATA.teams.forEach((t1, i) => {
        for (let j = i + 1; j < RAW_DATA.teams.length; j++) {
          const t2 = RAW_DATA.teams[j];
          const m = matches[t1 + '_' + t2];
          if (m && m.winner) {
            wins[m.winner]++;
            const loser = m.winner === t1 ? t2 : t1;
            losses[loser]++;
          }
        }
      });

      const winGroups = {};
      Object.keys(wins).forEach(t => {
        const w = wins[t];
        if (!winGroups[w]) winGroups[w] = [];
        winGroups[w].push(t);
      });

      const standings = [];
      const tieNotes = [];

      function resolveGroup(group) {
        if (group.length === 1) {
          return [{ team: group[0], status: '確定', note: '単独' + wins[group[0]] + '勝' }];
        } else if (group.length === 2) {
          const a = group[0], b = group[1];
          const m = matches[a + '_' + b];
          if (m && m.winner) {
            const w = m.winner;
            const l = w === a ? b : a;
            const scW = matches[w + '_' + l].score1;
            const scL = matches[w + '_' + l].score2;
            const scText = (scW !== null && scL !== null) ? '(' + scW + '-' + scL + ')' : '';
            return [
              { team: w, status: '確定', note: '直接対決で' + l + 'に勝利 ' + scText },
              { team: l, status: '確定', note: '直接対決で' + w + 'に敗北 ' + scText }
            ];
          } else {
            return [
              { team: a, status: 'タイ(未対戦)', note: b + 'との直接対決が未対戦' },
              { team: b, status: 'タイ(未対戦)', note: a + 'との直接対決が未対戦' }
            ];
          }
        } else {
          const subWins = {};
          const hasUnplayed = [];
          group.forEach(t => subWins[t] = 0);

          for (let i = 0; i < group.length; i++) {
            for (let j = i + 1; j < group.length; j++) {
              const a = group[i], b = group[j];
              const m = matches[a + '_' + b];
              if (m && m.winner) {
                subWins[m.winner]++;
              } else {
                hasUnplayed.push(a + ' vs ' + b);
              }
            }
          }

          if (hasUnplayed.length > 0) {
            return group.map(t => ({
              team: t,
              status: 'タイ(未対戦あり)',
              note: hasUnplayed.join(', ') + ' が未対戦'
            }));
          }

          const subGroups = {};
          Object.keys(subWins).forEach(t => {
            const sw = subWins[t];
            if (!subGroups[sw]) subGroups[sw] = [];
            subGroups[sw].push(t);
          });

          if (Object.keys(subGroups).length > 1) {
            const res = [];
            Object.keys(subGroups).map(Number).sort((a,b) => b-a).forEach(sw => {
              const sg = subGroups[sw];
              const subRes = resolveGroup(sg);
              subRes.forEach(item => {
                item.note = '直接ミニリーグ' + sw + '勝 ' + (item.note.startsWith('単独') ? '' : '(' + item.note + ')');
              });
              res.push(...subRes);
            });
            return res;
          } else {
            const unplayedGames = [];
            for (let i = 0; i < group.length; i++) {
              for (let j = i + 1; j < group.length; j++) {
                const a = group[i], b = group[j];
                const key = [a, b].sort().join('_');
                if (futurePairs.has(key)) unplayedGames.push(a + ' vs ' + b);
              }
            }

            const diffs = {};
            const diffPastOnly = {};
            group.forEach(t => {
              let gdAll = 0;
              let gdPast = 0;
              group.forEach(opp => {
                if (opp !== t) {
                  const m = matches[t + '_' + opp];
                  if (m.score1 !== null && m.score2 !== null) {
                    gdAll += (m.score1 - m.score2);
                    if (m.round <= 5) gdPast += (m.score1 - m.score2);
                  }
                }
              });
              diffs[t] = gdAll;
              diffPastOnly[t] = gdPast;
            });

            if (!applyScoresToGoalDiff && unplayedGames.length > 0) {
              const unplayedStr = unplayedGames.join(' / ');
              const pastStr = group.map(t => t + ': ' + (diffPastOnly[t] >= 0 ? '+' : '') + diffPastOnly[t]).join(', ');
              tieNotes.push({
                teams: group,
                unplayedStr: unplayedStr,
                pastDiffs: pastStr
              });

              return group.map(t => ({
                team: t,
                status: 'タイ(未確定)',
                note: '三つ巴(現得失点 ' + (diffPastOnly[t] >= 0 ? '+' : '') + diffPastOnly[t] + ') ※' + unplayedStr + '次第'
              }));
            } else {
              const diffGroups = {};
              Object.keys(diffs).forEach(t => {
                const d = diffs[t];
                if (!diffGroups[d]) diffGroups[d] = [];
                diffGroups[d].push(t);
              });

              const res = [];
              Object.keys(diffGroups).map(Number).sort((a,b) => b-a).forEach(d => {
                const dg = diffGroups[d];
                if (dg.length === 1) {
                  res.push({
                    team: dg[0],
                    status: '確定',
                    note: '当該得失点差: ' + (d >= 0 ? '+' : '') + d
                  });
                } else if (dg.length === 2) {
                  const a = dg[0], b = dg[1];
                  const m = matches[a + '_' + b];
                  const w = m.winner;
                  const l = w === a ? b : a;
                  res.push({ team: w, status: '確定', note: '当該得失点同点(' + (d >= 0 ? '+' : '') + d + ')・直接勝' });
                  res.push({ team: l, status: '確定', note: '当該得失点同点(' + (d >= 0 ? '+' : '') + d + ')・直接敗' });
                } else {
                  dg.forEach(t => res.push({ team: t, status: 'タイ(同点)', note: '当該得失点同点: ' + (d >= 0 ? '+' : '') + d }));
                }
              });
              return res;
            }
          }
        }
      }

      Object.keys(winGroups).map(Number).sort((a, b) => b - a).forEach(w => {
        const resolved = resolveGroup(winGroups[w]);
        resolved.forEach(it => {
          it.wins = w;
          it.losses = losses[it.team];
          it.points = w * 3;
          standings.push(it);
        });
      });

      // Render Mobile Standings List
      const container = document.getElementById('standings-mobile-list');
      container.innerHTML = '';

      standings.forEach((item, pos) => {
        const div = document.createElement('div');
        const isPO = pos < 3;
        const isWaseda = item.team === '早稲田';
        const isTie = item.status.includes('タイ');

        div.className = 'standings-item' + (isPO ? ' po-team' : '') + (isWaseda ? ' waseda-team' : '');

        div.innerHTML = `
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="rank-num ${isPO ? 'po' : ''}">${pos + 1}</span>
            <div>
              <div style="display:flex; align-items:center; gap:4px;">
                <span style="font-size:13px; font-weight:800; ${isWaseda ? 'color:#fb7185;' : ''}">${item.team}</span>
                ${isPO ? '<span class="badge badge-in">PO</span>' : ''}
                ${isTie ? '<span class="badge badge-tie">未定タイ</span>' : ''}
              </div>
              <div style="font-size:10px; color:${isTie ? '#fbbf24' : 'var(--text-muted)'}; margin-top:1px;">
                ${item.note}
              </div>
            </div>
          </div>
          <div style="text-align:right; flex-shrink:0;">
            <div style="font-size:13px; font-weight:800;">${item.wins}勝${item.losses}敗</div>
            <div style="font-size:10px; color:var(--text-muted); font-weight:600;">勝点 ${item.points}</div>
          </div>
        `;
        container.appendChild(div);
      });

      // Alert Panel
      const alertBox = document.getElementById('tiebreak-alert-panel');
      if (tieNotes.length > 0) {
        alertBox.style.display = 'block';
        alertBox.innerHTML = `
          <strong style="color:#fbbf24;">⚠️ 得失点差が未確定のタイ</strong><br>
          ${tieNotes.map(tn => `
            ・${tn.teams.join('/')}（未消化: ${tn.unplayedStr}）<br>
            ・第5節終了時得失点差: ${tn.pastDiffs}
          `).join('<br>')}
        `;
      } else {
        alertBox.style.display = 'none';
      }

      // Update Header Status
      updateWasedaStickyBar(standings);
    }

    function updateWasedaStickyBar(standings) {
      const wIdx = standings.findIndex(it => it.team === '早稲田');
      const wItem = standings[wIdx];
      const isTie = wItem.status.includes('タイ');

      const unplayedCount = current_outcomes.filter(x => x === null).length;
      const lockedCount = current_locked.filter(x => x === true).length;

      document.getElementById('waseda-score-text').textContent = `${wItem.wins}勝 ${wItem.losses}敗 (勝点 ${wItem.points})`;
      document.getElementById('unplayed-count-text').textContent = (lockedCount > 0 ? `✅${lockedCount}確定 / ` : '') + `未設定 ${unplayedCount} 試合`;

      const badge = document.getElementById('waseda-status-badge');
      const title = document.getElementById('waseda-verdict-title');

      if (unplayedCount > 0) {
        badge.className = 'badge badge-blue';
        badge.textContent = `暫定 ${wIdx + 1} 位`;
        title.style.color = '#60a5fa';
        title.textContent = '試合選択中';
      } else if (isTie) {
        const tieMembers = standings.map((it, idx) => ({ it, idx })).filter(x => x.it.wins === wItem.wins && x.it.status.includes('タイ'));
        const minRank = Math.min(...tieMembers.map(x => x.idx)) + 1;
        const maxRank = Math.max(...tieMembers.map(x => x.idx)) + 1;

        if (maxRank <= 3) {
          badge.className = 'badge badge-in';
          badge.textContent = `${minRank}〜${maxRank}位タイ`;
          title.style.color = '#34d399';
          title.textContent = 'PO進出確定！';
        } else if (minRank > 3) {
          badge.className = 'badge badge-out';
          badge.textContent = `${minRank}〜${maxRank}位タイ`;
          title.style.color = '#f87171';
          title.textContent = '敗退確定';
        } else {
          badge.className = 'badge badge-tie';
          badge.textContent = `${minRank}〜${maxRank}位タイ`;
          title.style.color = '#fbbf24';
          title.textContent = '3位争い未定';
        }
      } else {
        if (wIdx < 3) {
          badge.className = 'badge badge-in';
          badge.textContent = `${wIdx + 1} 位確定`;
          title.style.color = '#34d399';
          title.textContent = 'PO進出確定！';
        } else {
          badge.className = 'badge badge-out';
          badge.textContent = `${wIdx + 1} 位確定`;
          title.style.color = '#f87171';
          title.textContent = '敗退確定';
        }
      }

      // Pattern #
      const pBadge = document.getElementById('pattern-num-badge');
      if (unplayedCount === 8) {
        pBadge.textContent = '第5節終了時点';
      } else if (unplayedCount > 0) {
        pBadge.textContent = `残り${unplayedCount}試合未設定`;
      } else {
        let patternIdx = -1;
        RAW_DATA.patterns.forEach(p => {
          let match = true;
          for (let i = 0; i < 8; i++) {
            if (p.outcome[i] !== current_outcomes[i]) {
              match = false; break;
            }
          }
          if (match) patternIdx = p.id;
        });
        pBadge.textContent = patternIdx !== -1 ? `#${patternIdx} / 256` : 'カスタム設定';
      }
    }

    function getFilteredPatterns() {
      return RAW_DATA.patterns.filter(p => {
        for (let i = 0; i < 8; i++) {
          if (current_locked[i]) {
            if (p.outcome[i] !== current_outcomes[i]) return false;
          }
        }
        return true;
      });
    }

    function togglePatternExpand(patternId) {
      if (expandedCardId === patternId) {
        expandedCardId = null; // collapse
      } else {
        expandedCardId = patternId; // expand
      }
      renderPatternsList(currentFilter);
    }

    function renderPatternsList(filter) {
      currentFilter = filter;
      const container = document.getElementById('patterns-mobile-container');
      container.innerHTML = '';

      const matchedPatterns = getFilteredPatterns();
      const lockedCount = current_locked.filter(x => x === true).length;

      const countIn = matchedPatterns.filter(p => p.waseda_status === '進出確定').length;
      const countTie = matchedPatterns.filter(p => p.waseda_status === '未確定').length;
      const countOut = matchedPatterns.filter(p => p.waseda_status === '敗退確定').length;
      const countAll = matchedPatterns.length;

      document.getElementById('cnt-all').textContent = countAll;
      document.getElementById('cnt-in').textContent = countIn;
      document.getElementById('cnt-tie').textContent = countTie;
      document.getElementById('cnt-out').textContent = countOut;

      const badgeHeader = document.getElementById('pattern-filter-badge');
      const descHeader = document.getElementById('pattern-filter-desc');

      if (lockedCount > 0) {
        badgeHeader.className = 'badge badge-amber';
        badgeHeader.textContent = `合致: ${countAll} パターン`;
        descHeader.innerHTML = `<span style="color:#34d399; font-weight:700;">✅ ${lockedCount}試合確定中</span> ─ タップすると1〜8位の全詳細が展開されます。`;
      } else {
        badgeHeader.className = 'badge badge-blue';
        badgeHeader.textContent = `${countAll} パターン`;
        descHeader.textContent = 'カードをタップすると1〜8位の順位詳細・タイブレーク理由が展開されます。';
      }

      const shortNames = {
        '早稲田': '早', '明治大': '明', '法政大': '法', '東京大': '東',
        '立教大': '立', '中央大': '中', '慶應大': '慶', '日体大': '日'
      };

      matchedPatterns.forEach(p => {
        if (filter !== 'all' && !p.waseda_status.includes(filter)) return;

        const isExpanded = (expandedCardId === p.id);
        const div = document.createElement('div');
        div.className = 'pattern-card' + (isExpanded ? ' expanded' : '');

        const badgeClass = p.waseda_status === '進出確定' ? 'badge-in' : (p.waseda_status === '未確定' ? 'badge-tie' : 'badge-out');

        const winLetters = p.outcome.map((winIdx, gIdx) => {
          const t = winIdx === 0 ? RAW_DATA.rem_games[gIdx].team1 : RAW_DATA.rem_games[gIdx].team2;
          const isL = current_locked[gIdx];
          return isL ? `<strong style="color:#34d399;">${shortNames[t]}</strong>` : shortNames[t];
        }).join('');

        const top3Names = p.ranking.slice(0, 3).map(it => shortNames[it.team]).join('・');

        // Build detailed 1st to 8th ranking HTML
        const rankingRowsHtml = p.ranking.map((it, rkIdx) => {
          const isPO = rkIdx < 3;
          const isWaseda = it.team === '早稲田';
          const isTie = it.status.includes('タイ');

          return `
            <div class="detail-rank-row ${isPO ? 'po' : ''} ${isWaseda ? 'waseda' : ''}">
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-weight:800; width:16px; text-align:center; color:${isPO ? '#34d399' : 'var(--text-muted)'};">${rkIdx + 1}</span>
                <span style="font-weight:700; ${isWaseda ? 'color:#fb7185;' : ''}">${it.team}</span>
                ${isPO ? '<span class="badge badge-in" style="font-size:9px; padding:1px 4px;">PO</span>' : ''}
                ${isTie ? '<span class="badge badge-tie" style="font-size:9px; padding:1px 4px;">タイ</span>' : ''}
              </div>
              <div style="text-align:right;">
                <span style="font-weight:700;">${it.wins}勝${7 - it.wins}敗</span>
                <span style="font-size:10px; color:${isTie ? '#fbbf24' : 'var(--text-muted)'}; display:block; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${it.note}">
                  ${it.note || '単独勝数'}
                </span>
              </div>
            </div>
          `;
        }).join('');

        // Build match outcomes list for this pattern
        const matchesSummaryHtml = RAW_DATA.rem_games.map((g, gIdx) => {
          const w = p.outcome[gIdx] === 0 ? g.team1 : g.team2;
          return `<span style="padding:2px 5px; background:var(--card); border:1px solid var(--border); border-radius:4px; font-size:10px;">${g.code}:${w}勝</span>`;
        }).join(' ');

        div.innerHTML = `
          <div class="pattern-header" onclick="togglePatternExpand(${p.id})">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-family:monospace; font-weight:800; color:var(--text-muted);">#${p.id}</span>
                <span class="badge ${badgeClass}">${p.waseda_status}</span>
              </div>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-size:11px; font-weight:800; color:#34d399;">PO圏: ${top3Names}</span>
                <span style="font-size:10px; color:var(--text-muted);">${isExpanded ? '▲' : '▼'}</span>
              </div>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px;">
              <span style="color:var(--text-muted); font-family:monospace;">勝敗: ${winLetters}</span>
              <span style="color:var(--primary); font-size:10px; font-weight:700;">
                ${isExpanded ? 'タップで閉じる ▲' : 'タップで1〜8位詳細 ▼'}
              </span>
            </div>
          </div>

          <!-- Expanded Drilldown Panel -->
          <div class="pattern-details-panel">
            <div style="font-size:10px; color:var(--text-muted); margin-bottom:6px; line-height:1.6;">
              <strong>試合結果:</strong> ${matchesSummaryHtml}
            </div>

            <div style="font-size:11px; font-weight:800; margin-bottom:6px; color:#38bdf8;">
              🏆 最終順位 & タイブレーク理由:
            </div>

            <div style="display:flex; flex-direction:column; gap:2px;">
              ${rankingRowsHtml}
            </div>

            <button class="btn-apply-pattern" onclick="event.stopPropagation(); loadPattern(${JSON.stringify(p.outcome)});">
              <span>⚡ この展開をシミュレーターにセット</span>
            </button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function filterPatterns(filter) {
      renderPatternsList(filter);
    }

    function loadPattern(outcome) {
      outcome.forEach((wIdx, gIdx) => {
        if (!current_locked[gIdx]) {
          current_outcomes[gIdx] = wIdx;
          if (wIdx === 0) current_scores[gIdx] = { score1: 24, score2: 17 };
          else current_scores[gIdx] = { score1: 17, score2: 24 };
        }
      });
      saveStateToStorage();
      renderMatchCards();
      calculateAndRenderStandings();
      switchTab('sim');
    }
  </script>
</body>
</html>
